# API base. Use /api when the host proxies /api and /uploads to the Express server
# (on Vercel, client/vercel.json does this). A full API URL on another site makes the login
# cookie third-party, which Safari/iPhone and in-app browsers block.
VITE_API_URL=/api

# Public frontend origin, used for storefront share links, canonical URLs, and Open Graph URLs.
# Set this to the real domain for production builds. Canonical tags are skipped for localhost.
VITE_APP_ORIGIN=http://localhost:5173

# Optional: absolute sitemap URL added to robots.txt at build time
# (for example https://api.example.com/api/seo/sitemap.xml). Leave empty until the domain is live.
VITE_SITEMAP_URL=
