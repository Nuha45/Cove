NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers. Replace USER, PASSWORD, and the cluster host.
# The database name at the end should be cove.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cove?retryWrites=true&w=majority

# Automated tests only (npm test). Must be a different database whose name contains "test".
# Tests never read MONGODB_URI and refuse to run if this points at the same database.
# Prefer a database user that only has readWrite on cove_test.
TEST_MONGODB_URI=

# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The React app URL. Required so the browser is allowed to send the login cookie.
# Required when NODE_ENV=production. Comma-separate several origins if needed (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# --- Deployment ---
# Reverse-proxy hops in front of the API (most hosts: 1). Defaults to 1 in production, off in development.
# TRUST_PROXY=1
# Frontend on Vercel rewriting /api to the API adds a second proxy. To check which IP rate limits see,
# set LOG_PROXY_IPS=true, redeploy, load the site from your phone on mobile data, read the
# "[proxy-check]" lines in the API logs, then remove LOG_PROXY_IPS again.
# LOG_PROXY_IPS=false
# Login cookie SameSite: lax | strict | none. Default: none in production (frontend and API on
# different sites), lax in development. Use lax when frontend and API share a registrable domain
# (for example app.example.com + api.example.com).
# COOKIE_SAME_SITE=
# Public frontend origin (for example https://cove.example.com). Enables GET /api/seo/sitemap.xml.
# Leave empty until the real domain is live.
PUBLIC_SITE_URL=

# --- Image storage (Cloudinary) ---
# Required for product images, logos, storefront covers, and payment QR uploads.
# Cloudinary Console -> Dashboard (Product Environment Credentials).
# Server-side only. Never put these in VITE_ client env vars or commit real values.
# Without them the API still runs, but image uploads fail with a clear "not set up" error.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cove SaaS billing (Razorpay Subscriptions) ---
# This account is for SELLER → COVE only. Never put secrets in VITE_ client env vars.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create one monthly ₹599 INR plan in the Razorpay Dashboard and paste its plan_id here.
# (The older name RAZORPAY_PLAN_ID is still accepted if RAZORPAY_PRO_PLAN_ID is empty.)
RAZORPAY_PRO_PLAN_ID=
# Cove Plus (internal key "advanced"): create a second monthly ₹899 INR plan and paste its plan_id here.
# Each plan's checkout stays disabled ("Payments are currently being configured") until its ID is set.
RAZORPAY_ADVANCED_PLAN_ID=

# New businesses always get a 7-day Cove Plus trial (fixed in code; COVE_TRIAL_DAYS is no longer read).
# Set to false to stop granting trials on register (existing shops are not re-trialed).
COVE_GRANT_TRIAL_ON_REGISTER=true
# When a shop has no running trial and no paid plan, its storefront is paused and new orders are blocked.
# Seller accounts and data are never removed. On by default; set to false only to switch the pause off.
COVE_ENFORCE_BILLING=true

# --- Transactional email (optional) ---
# Used for password reset and seller/customer event emails.
# If unset, Cove stays up and skips sending (logs in development).
# Supported providers: console | memory | resend
#
# Resend setup:
# 1. Create an API key in the Resend dashboard.
# 2. Verify a domain, OR use Resend's test sender (e.g. Cove <onboarding@resend.dev>).
# 3. EMAIL_FROM must be a sender Resend allows — a random Gmail address will be rejected.
# 4. Restart the API after changing these values.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# Public app URL used in email links (defaults to CLIENT_ORIGIN).
APP_URL=http://localhost:5173
# Dev only. Never enable in production. Allows reset URL in email meta for local debugging.
EMAIL_DEBUG_LINKS=false

# --- Scheduled jobs (Cove Plus weekly reports) ---
# Long random secret (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# A scheduler calls:  POST {API}/api/jobs/weekly-reports  with header  Authorization: Bearer <CRON_SECRET>
# Jobs return 503 until this is set. Repeated calls in the same week never send duplicate emails.
CRON_SECRET=

# --- Analytics ---
# IANA time zone used to group analytics by day/hour and to define report weeks.
COVE_ANALYTICS_TIMEZONE=Asia/Kolkata
