NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers. Replace USER, PASSWORD, and the cluster host.
# The database name at the end should be cove.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cove?retryWrites=true&w=majority

# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The React app URL. Required so the browser is allowed to send the login cookie.
CLIENT_ORIGIN=http://localhost:5173

# --- Cove SaaS billing (Razorpay Subscriptions) ---
# This account is for SELLER → COVE only. Never put secrets in VITE_ client env vars.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create one monthly ₹599 INR plan in the Razorpay Dashboard and paste its plan_id here.
RAZORPAY_PLAN_ID=

# Trial length in days for new businesses (server-controlled).
COVE_TRIAL_DAYS=30
# Set to false to stop granting trials on register (existing shops are not re-trialed).
COVE_GRANT_TRIAL_ON_REGISTER=true
# Set to true only when you are ready to restrict the app by subscription status.
COVE_ENFORCE_BILLING=false

# --- AI Marketing (optional) ---
# Server-side only. Never put these in VITE_ client env vars.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local demo only. When true (and NODE_ENV is not production), Generate returns
# sample marketing copy with no OpenAI network call or API charge.
# Ignored automatically when NODE_ENV=production.
AI_MOCK_MODE=false

# --- Transactional email (optional) ---
# Used for password reset and seller/customer event emails.
# If unset, Cove stays up and skips sending (logs in development).
# Supported providers: console | memory | resend
#
# Resend setup:
# 1. Create an API key in the Resend dashboard.
# 2. Verify a domain, OR use Resend's test sender (e.g. Cove <onboarding@resend.dev>).
# 3. EMAIL_FROM must be a sender Resend allows — a random Gmail address will be rejected.
# 4. Restart the API after changing these values.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# Public app URL used in email links (defaults to CLIENT_ORIGIN).
APP_URL=http://localhost:5173
# Dev only. Never enable in production. Allows reset URL in email meta for local debugging.
EMAIL_DEBUG_LINKS=false
